# BIWORK backend configuration (copy to .env for local development; use a secrets manager in production).
# Never commit real keys. API keys are read only by the backend and workers; never expose them to the frontend.

APP_ENV=dev
DATABASE_URL=postgresql+psycopg://biwork_app:biwork_app@localhost:5432/biwork
DATABASE_MIGRATION_URL=postgresql+psycopg://biwork:biwork@localhost:5432/biwork
REDIS_URL=redis://localhost:6379/0
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-of-32-chars-or-more
# FIELD_ENCRYPTION_KEY=   # Fernet key, required in staging/prod
# CELERY_ALWAYS_EAGER=true  # single-process local development without a worker

# --------------------------------------------------------------------------- AI providers (docs/ai-engine.md)
# No key at all = labelled demo mode (rule-based, not real AI). Each provider whose key is set needs
# <PROVIDER>_MODEL_DEFAULT. Model ids are placeholders: use ids your account can access and verify
# them with `python -m app.cli ai-models`.
OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=
OPENAI_MODEL_COMPLEX=
OPENAI_MODEL_ECONOMY=
OPENAI_MODEL_VISION=
# OPENAI_BASE_URL=
# OPENAI_ORGANIZATION=

GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=
GEMINI_MODEL_COMPLEX=
GEMINI_MODEL_ECONOMY=
GEMINI_MODEL_VISION=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5-5
ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5
ANTHROPIC_MODEL_ECONOMY=claude-haiku-5-5

AI_PROVIDER=auto
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDERS=openai,gemini,anthropic
AI_ROUTING_ENABLED=true
AI_FALLBACK_ENABLED=true
AI_REVIEW_REQUIRED=true
# AI_ROUTING_FILE=/etc/biwork/routing.json

# Limits, reliability, cost
AI_TIMEOUT_S=60
AI_MAX_RETRIES=2
AI_MAX_CALLS_PER_MINUTE=60
AI_MAX_INPUT_TOKENS=40000
AI_ESCALATION_CONFIDENCE=0.6
AI_CACHE_TTL_S=86400
AI_HEALTH_FAILURE_THRESHOLD=3
AI_HEALTH_COOLDOWN_S=120
# USD per 1M tokens [input, output] for models without a built-in price (OpenAI, Gemini):
# AI_PRICING_JSON={"<model-id>": [0.0, 0.0]}

# OCR
OCR_ENABLED=true
OCR_LANGS=eng+rus+uzb+uzb_cyrl
