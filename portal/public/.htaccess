# Biwork Portal — Apache qoidalari. Hujjatlar ildizi (Document root) = .../portal/public
DirectoryIndex index.php
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^router\.php$ - [F,L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^api(/.*)?$ api.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(js|css|svg|png|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # mahsulot ekran rasmlari manzilida ?v=<o'zgargan vaqt> bor — uzoq saqlash xavfsiz
  <FilesMatch "\.webp$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
</IfModule>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
