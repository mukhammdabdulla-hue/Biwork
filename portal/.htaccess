# Biwork Portal — loyiha ildizi. To'g'ri sozlash: Hujjatlar ildizi (Document root) = .../portal/public
# Agar ildiz noto'g'ri bo'lib, shu papka ochilib qolsa: maxfiy papkalar yopiladi va public/ ga yo'naltiriladi.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(src|data)(/|$) - [F,L]
  RewriteRule ^config\.php$ - [F,L]
  RewriteCond %{REQUEST_URI} !/public/
  RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
  RewriteRule ^(.*)$ %1public/$1 [R=302,L]
</IfModule>
