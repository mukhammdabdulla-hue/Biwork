# BIWORK configuration. Copy to .env and fill in every value marked "change me".
# The backend reads these variables directly (backend/app/config.py); docker-compose.yml
# also uses them to configure Postgres and the service URLs.

# --- Runtime -------------------------------------------------------------------------------
# dev | test | staging | prod (staging/prod refuse unsafe settings)
APP_ENV=prod
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database (docker compose) -------------------------------------------------------------
POSTGRES_DB=biwork
# schema owner; runs migrations
POSTGRES_USER=biwork
POSTGRES_PASSWORD=change-me-owner
# API/worker role, subject to row-level security
APP_DB_USER=biwork_app
APP_DB_PASSWORD=change-me-app
# Outside docker compose, set the URLs directly instead:
# DATABASE_URL=postgresql+psycopg://biwork_app:...@localhost:5432/biwork
# DATABASE_MIGRATION_URL=postgresql+psycopg://biwork:...@localhost:5432/biwork
# DATABASE_APP_ROLE=biwork_app
# REDIS_URL=redis://localhost:6379/0

# --- Security ------------------------------------------------------------------------------
# Required: replace both values. staging/prod refuse to start with these placeholders (anything
# containing "change-me") and require FIELD_ENCRYPTION_KEY to be a valid Fernet key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me-at-least-32-characters-long-random
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me
# requires HTTPS in front of the web app
COOKIE_SECURE=true
CORS_ORIGINS=["https://biwork.example.com"]
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=14
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# --- Files ---------------------------------------------------------------------------------
# local: files on a volume shared by the API and workers (docker compose default).
# s3: any S3-compatible object storage; the bucket is created by `python -m app.cli bootstrap`.
STORAGE_BACKEND=local
# Directory for local storage (docker compose sets /data/storage on the shared volume).
# STORAGE_DIR=./var/storage
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=biwork-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
MAX_UPLOAD_MB=50
MAX_FILES_PER_JOB=20
# set to "clamav" with `--profile clamav` to scan uploads
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Background processing -----------------------------------------------------------------
# Development and tests only: run pipeline tasks in the API process instead of a Celery worker.
# CELERY_ALWAYS_EAGER=false
STAGE_TIMEOUT_SECONDS=900
WORKER_CONCURRENCY=2

# --- AI layer ------------------------------------------------------------------------------
# auto: use the providers whose API key is set, in AI_PRIMARY_PROVIDER / AI_FALLBACK_PROVIDERS order;
#       with no key at all it runs the labelled demo mode (refused in staging/prod).
# openai | gemini | anthropic: force one provider (its key is required).
# demo (alias: mock): deterministic rules, labelled "Mock AI — not real analysis" in the UI.
# Full reference: docs/ai-engine.md. Keys stay server-side; never put them in frontend env files.
AI_PROVIDER=demo
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDERS=openai,gemini,anthropic
AI_ROUTING_ENABLED=true
AI_FALLBACK_ENABLED=true
AI_REVIEW_REQUIRED=true

OPENAI_API_KEY=
OPENAI_MODEL_DEFAULT=
OPENAI_MODEL_COMPLEX=
OPENAI_MODEL_ECONOMY=
GEMINI_API_KEY=
GEMINI_MODEL_DEFAULT=
GEMINI_MODEL_COMPLEX=
GEMINI_MODEL_ECONOMY=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-5-5
ANTHROPIC_MODEL_COMPLEX=claude-opus-5-5
ANTHROPIC_MODEL_ECONOMY=claude-haiku-5-5

AI_EFFORT=medium
AI_TIMEOUT_S=60
AI_MAX_RETRIES=2
AI_REFUSAL_FALLBACK=true
AI_MAX_CALLS_PER_MINUTE=60
AI_MAX_INPUT_CHARS=120000
AI_MAX_INPUT_TOKENS=40000

# --- OCR -----------------------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANGS=eng+rus+uzb+uzb_cyrl
# Path to the tesseract binary when it is not on PATH.
# TESSERACT_CMD=

# --- BIWORK Agent --------------------------------------------------------------------------
AGENT_COMMIT_BATCH_SIZE=500
AGENT_CONFIDENCE_THRESHOLD=0.8

WEB_PORT=8080
